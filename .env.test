# Test-only environment. Committed on purpose so `npm run test:run` works on a
# fresh clone and in CI, neither of which has the gitignored .env.
# Nothing here is a secret — MSW intercepts every request, so no host is real.
# The URL must match the base the tests build their handlers from.
VITE_API_URL=http://localhost:5001/api

VITE_GOOGLE_CLIENT_ID=test-google-client-id
VITE_GOOGLE_API_KEY=test-google-api-key
VITE_GITHUB_CLIENT_ID=test-github-client-id
